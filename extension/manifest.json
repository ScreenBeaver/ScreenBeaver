{
  "manifest_version": 3,
  "name": "Screen Beaver Companion",
  "version": "0.1.0",
  "description": "Sends precise tab cursor + Shift/Ctrl+Click zooms to the Screen Beaver desktop app.",
  "permissions": ["storage"],
  "host_permissions": ["http://127.0.0.1:17355/*", "http://localhost:17355/*"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "action": {
    "default_title": "Screen Beaver Companion",
    "default_popup": "popup.html"
  },
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  }
}
